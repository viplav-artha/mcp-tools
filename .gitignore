# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables / secrets — never commit these
.env
.env.*
!.env.example
!.env.sample
.webui_secrets_key

# TLS private key and self-signed cert (environment-specific, generated
# locally for connecting this server to a NemoClaw sandbox) — never commit
*.pem
*.key
*.crt

# Testing / coverage
.pytest_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# Type checkers / linters
.mypy_cache/
.pytype/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# IDEs / editors
.vscode/
.idea/
*.swp

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Local reference clone of the other repo (viplav-artha/tools) — not part of this project
reference-tools-repo/
openwebui-venv/

# rag-text-to-sql (tool branch) is a git submodule now (see .gitmodules),
# NOT gitignored — its pointer/commit reference is tracked, so a fresh
# clone with `git clone --recurse-submodules` (or `git submodule update
# --init`) fetches the actual code automatically.

# Open WebUI runtime state (secret key, local sqlite db, uploads) — not part of this project
.webui_secret_key
data/
webui.db

# Local RAG knowledge store for the text_to_sql tool (rag-text-to-sql's
# rag_store.db, copied in from an already-ingested instance) — environment
# data, not source code; re-copy or re-run ingest_knowledge.py to recreate.
*.db
*.sqlite3
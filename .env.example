# Copy this file to .env and fill in real values. Never commit .env itself.

# Tavily API key (get one at https://tavily.com) — used by tools/web_search.py
# when provider='tavily' is requested. Not needed for the default
# provider='duckduckgo', which is free and requires no key.
TAVILY_API_KEY=your-tavily-api-key

# Comma-separated list of origins allowed to call this MCP server over
# Streamable HTTP (CORS). Defaults to the local Open WebUI dev origin.
# Update this to the real Open WebUI domain once deployed — never use "*"
# once this server is reachable outside your own machine.
CORS_ALLOWED_ORIGINS=http://localhost:8080

# TLS (optional): set both to serve HTTPS instead of plain HTTP. Leave both
# blank to keep serving plain HTTP (existing local Claude Code / Open WebUI
# setup is unaffected). Point these at the self-signed cert/key generated for
# connecting this server to a NemoClaw sandbox via `nemoclaw mcp add`.
TLS_CERT_FILE=
TLS_KEY_FILE=

# Required for tools/text_to_sql.py (wraps viplav-artha/rag-text-to-sql,
# `tool` branch, installed as an editable dependency — see README). Also
# needs: that repo cloned as ./rag-text-to-sql, and an ingested rag_store.db
# (copy an already-ingested one, or run `python -m scripts.ingest_knowledge`
# from inside ./rag-text-to-sql).
NEON_BRANCH=RAG
DATABASE_URL=postgresql://user:password@host/dbname
# No REDIS_URL needed — caching/Redis was removed from rag-text-to-sql
# entirely, and its config no longer reads or validates this var at all.
AWS_PROFILE=your-aws-profile
AWS_REGION=us-east-1
# Direct Bedrock model ID (not the us.-prefixed cross-region inference
# profile) — depends on what your AWS role/profile actually has
# bedrock:InvokeModel access to.
BEDROCK_CHAT_MODEL_ID=amazon.nova-pro-v1:0

# Copy this file to .env and fill in real values. Never commit .env itself.

# Tavily API key (get one at https://tavily.com) — used by tools/web_search.py
# when provider='tavily' is requested. Not needed for the default
# provider='duckduckgo', which is free and requires no key.
TAVILY_API_KEY=your-tavily-api-key
